# OpenAI
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini

# Google Chat incoming webhook for the target space
GOOGLE_CHAT_WEBHOOK_URL=https://chat.googleapis.com/v1/spaces/XXXX/messages?key=...&token=...

# Schedule (24h HH:MM, comma-separated for multiple)
LUNCH_TIMES=12:30
TEA_TIMES=15:30
TIMEZONE=Asia/Colombo
# Days to send: mon-fri, or e.g. mon,tue,wed
SCHEDULE_DAYS=mon-fri

# Personality of the messages
VIBE=casual, dry and witty like a dev teammate, generous with food emojis
TEAM_NAME=Agent Manager Team

# Send a static message if AI generation fails (default: false = AI only)
ALLOW_STATIC_FALLBACK=false

# Attach a GIF to lunch/tea messages
SEND_GIF=true
# Optional: fresh random GIF from Giphy each time (free key at developers.giphy.com)
GIPHY_API_KEY=
LUNCH_GIF_QUERY=hungry
TEA_GIF_QUERY=tea time
# Optional: your own comma-separated GIF URLs (override built-ins)
LUNCH_GIF_URLS=https://lh5.googleusercontent.com/proxy/kCYn1T8dfpT-DahTs9cFIr5lUzu6iifCpAbzUGNzXJPmFMNpB0PLSYMtbxANU6W94fMqM2p59hDVWG1lbMce3rI23qP0HHHtUilHH3t6Om0
TEA_GIF_URLS=https://lh5.googleusercontent.com/proxy/l6RaNrQUsZEBdiHkoVvvs-N7kpGawtmajVpKOey-1x4YEhmeqepxJLxy4soxH0YxZ7Li04TEVaHAuhI6SZ7cWN5JBE8oyr-xE2fUJw

# Never send scheduled messages on Saturday/Sunday
SKIP_WEEKENDS=true

# Commute reminder to a second chat group (scheduler only, mon-fri; never used by /chat)
COMMUTE_WEBHOOK_URL=
COMMUTE_TIMES=13:30
COMMUTE_MESSAGE=🚗 Don't forget to book the commute!
